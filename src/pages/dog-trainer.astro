---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { site, seo } from '../config/site';

// Trainer / author page. One person = the sole trainer AND the sole blog author,
// so this single page serves both roles (CLAUDE.md portability + E-E-A-T):
//  - byline on every BlogPosting points here via Person @id "#person"
//  - verifiable credentials build author authority (Google reads the links)
// IP guardrails (§8): Susan Garrett is credit-only (no instructor claim, no
// program name / logo / slogan); มอมแมม = inspiration, not a behaviour-fix ad (§9).

const personId = `${site.domain}/dog-trainer#person`;

// Latest posts by this author — an in-page "author archive" that also feeds
// internal links (SEO) and shows the trainer is actively writing.
const latest = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const fmt = (d: Date) =>
  d.toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' });

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': personId,
  name: `ครู${site.teacher}`,
  alternateName: site.teacherNameEn,
  jobTitle: 'ครูฝึกสุนัข · game-based dog trainer',
  description:
    'ครูฝึกสุนัขถึงบ้าน กรุงเทพฯ สไตล์เล่นไปฝึกไป ไม่ดุ ไม่บังคับ — สอนผ่านการเล่นและให้หมาได้เลือกเอง',
  url: `${site.domain}/dog-trainer`,
  image: new URL(seo.ogImage, site.domain).href,
  worksFor: { '@type': 'Organization', name: site.name, url: site.domain },
  knowsAbout: [
    'การฝึกสุนัขเชิงบวก',
    'game-based dog training',
    'พฤติกรรมสุนัข',
    'โภชนาการสุนัข',
    'การสอนสุนัขเรียกแล้วมา (recall)',
  ],
  sameAs: Object.values(site.social),
  hasCredential: site.credentials.map((c) => ({
    '@type': 'EducationalOccupationalCredential',
    name: c.name,
    credentialCategory: 'certificate',
    recognizedBy: { '@type': 'Organization', name: c.issuer },
    ...(c.url ? { url: c.url } : {}),
  })),
};
---
<BaseLayout
  title={`เกี่ยวกับครู${site.teacher} — ครูฝึกสุนัขถึงบ้าน กรุงเทพฯ | ${site.name}`}
  description={`รู้จักครู${site.teacher} ครูฝึกสุนัขถึงบ้าน กรุงเทพฯ สไตล์เล่นไปฝึกไป ไม่ดุ ไม่บังคับ พร้อมคุณวุฒิด้านโภชนาการสัตว์เลี้ยง (NAVC) พฤติกรรมสุนัข (มหิดล) และการฝึกเชิงบวกจากคอร์สของ Susan Garrett`}
  path="/dog-trainer"
  ogImage={seo.ogImage}
>
  <Nav />

  <!-- HERO -->
  <header id="top" style="background:linear-gradient(180deg,#0E6360 0%,#178C88 100%);color:#FBF8F1;padding:clamp(48px,7vw,88px) clamp(16px,4vw,48px);">
    <div style="max-width:1000px;margin:0 auto;display:flex;flex-wrap:wrap;gap:clamp(28px,5vw,52px);align-items:center;">
      <div style="flex:1 1 300px;min-width:260px;">
        <div style="aspect-ratio:4/3;border-radius:24px;overflow:hidden;box-shadow:0 24px 48px -24px rgba(0,0,0,.55);">
          <ImageSlot src="/uploads/1745999842474.jpg" alt={`ครู${site.teacher} ครูฝึกสุนัขถึงบ้าน กับมอมแมม สุนัขพันธุ์เชลตี้`} placeholder="รูปครู + มอมแมม" />
        </div>
      </div>
      <div style="flex:1 1 360px;min-width:290px;">
        <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(244,193,60,.18);border:1px solid rgba(244,193,60,.45);color:#F4C13C;font-weight:600;font-size:14px;padding:7px 14px;border-radius:999px;margin-bottom:18px;">ครูฝึก · ผู้เขียนบทความ</div>
        <h1 style="font-family:'Chonburi',serif;font-weight:400;font-size:clamp(30px,5.2vw,50px);line-height:1.2;margin:0 0 16px;color:#FBF8F1;text-wrap:balance;">สวัสดีครับ ผมครู{site.teacher}</h1>
        <p style="font-size:clamp(16px,2vw,18px);line-height:1.85;color:rgba(251,248,241,.92);margin:0;">ครูฝึกสุนัขถึงบ้านของหมาสนุก ฝึกด้วยแนวทาง <strong style="color:#F4C13C;">เล่นไปฝึกไป</strong> {site.method}</p>
      </div>
    </div>
  </header>

  <!-- APPROACH -->
  <section data-reveal style="background:#FBF8F1;padding:clamp(52px,7vw,96px) clamp(16px,4vw,48px);">
    <div style="max-width:760px;margin:0 auto;">
      <h2 style="font-family:'Chonburi',serif;font-weight:400;font-size:clamp(24px,4vw,38px);line-height:1.25;margin:0 0 22px;color:#20302F;">แนวทางการฝึกของผม</h2>
      <p style="font-size:17px;line-height:1.9;color:#4a423a;margin:0 0 18px;">ผมเชื่อว่าหมาเรียนรู้ได้ดีที่สุดตอนที่มันสนุกและรู้สึกปลอดภัย ไม่ใช่ตอนที่ถูกดุหรือถูกบังคับ วิธี “เล่นไปฝึกไป” คือการจัดสถานการณ์ให้น้องได้ลองเลือกทำสิ่งที่ถูกด้วยตัวเอง แล้วเจอว่ามันเป็นเรื่องดี จนอยากทำซ้ำเอง ไม่ใช่เพราะกลัวหรือเพราะโดนสั่ง</p>
      <p style="font-size:17px;line-height:1.9;color:#4a423a;margin:0 0 18px;">แนวทางนี้ผม<strong>เรียนจากคอร์สของ Susan Garrett</strong> ครูฝึกและแชมป์ agility ระดับโลก ผู้ให้ความสำคัญกับการสร้างความสัมพันธ์และการให้หมาได้เลือกเอง มากกว่าการควบคุมหรือลงโทษ และผมยังเรียนรู้ต่อเนื่องทั้งด้านพฤติกรรมและโภชนาการสุนัข เพื่อดูแลน้องได้รอบด้าน</p>
      <div style="background:#E3F1EF;border-left:4px solid #178C88;border-radius:0 16px 16px 0;padding:20px 24px;margin-top:8px;">
        <p style="font-size:16px;line-height:1.85;color:#20302F;margin:0;">เป้าหมายของผมไม่ใช่แค่ให้น้อง “เชื่อฟัง” แต่คือให้น้อง “เลือกเป็น” มีความมั่นใจ และมีความสัมพันธ์ที่ไว้ใจกับเจ้าของ</p>
      </div>
    </div>
  </section>

  <!-- CREDENTIALS -->
  <section data-reveal style="background:#E3F1EF;padding:clamp(52px,7vw,96px) clamp(16px,4vw,48px);">
    <div style="max-width:860px;margin:0 auto;">
      <h2 style="font-family:'Chonburi',serif;font-weight:400;font-size:clamp(24px,4vw,38px);line-height:1.25;margin:0 0 12px;color:#20302F;text-align:center;">คุณวุฒิและการเรียนรู้ต่อเนื่อง</h2>
      <p style="text-align:center;font-size:16px;color:#3f6d6a;margin:0 auto 40px;max-width:48ch;">ผมเรียนรู้ต่อเนื่องเพื่อดูแลน้องได้อย่างเข้าใจและปลอดภัย ทั้งด้านพฤติกรรม การฝึก และโภชนาการ</p>
      <div style="display:grid;gap:16px;">
        {site.credentials.map((c) => (
          <div style="background:#fff;border:1px solid rgba(23,140,136,.16);border-radius:18px;padding:22px 24px;display:flex;flex-wrap:wrap;gap:14px 20px;align-items:center;justify-content:space-between;box-shadow:0 10px 24px -22px rgba(14,99,96,.7);">
            <div style="flex:1 1 340px;min-width:260px;">
              <h3 style="font-family:'Sarabun',sans-serif;font-weight:700;font-size:17.5px;color:#20302F;margin:0 0 5px;line-height:1.4;">{c.name}</h3>
              <p style="font-size:14.5px;color:#3f6d6a;margin:0 0 3px;">{c.issuer}</p>
              <p style="font-size:13.5px;color:#7c8a89;margin:0;">{c.note} · {c.year}</p>
            </div>
            {c.url ? (
              <a href={c.url} target="_blank" rel="noopener nofollow" style="flex:0 0 auto;display:inline-flex;align-items:center;gap:7px;background:#178C88;color:#fff;font-weight:600;font-size:14px;padding:10px 18px;border-radius:999px;text-decoration:none;">ตรวจสอบใบรับรอง →</a>
            ) : (
              <span style="flex:0 0 auto;font-size:13px;color:#7c8a89;background:#E3F1EF;padding:9px 16px;border-radius:999px;">รับรองโดย IAABC</span>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MOMMAM -->
  <section data-reveal style="background:#FBF8F1;padding:clamp(52px,7vw,96px) clamp(16px,4vw,48px);">
    <div style="max-width:760px;margin:0 auto;text-align:center;">
      <h2 style="font-family:'Chonburi',serif;font-weight:400;font-size:clamp(24px,4vw,38px);line-height:1.25;margin:0 0 18px;color:#20302F;">จุดเริ่มต้นชื่อ มอมแมม</h2>
      <p style="font-size:17px;line-height:1.9;color:#4a423a;margin:0 auto 18px;max-width:60ch;">จุดเริ่มของหมาสนุกคือ <strong style="color:#0E6360;">มอมแมม</strong> สุนัขพันธุ์เชลตี้ คู่หูที่ทำให้ผมลงลึกกับวิธีเล่นไปฝึกไป จนเชื่อสุดใจว่า การให้หมาได้เลือกและได้สนุก สร้างความสัมพันธ์ที่แข็งแรงกว่าการบังคับเสมอ</p>
      <a href="/mommam" style="display:inline-block;color:#178C88;font-weight:600;font-size:16px;text-decoration:none;">ดูโปรไฟล์การเรียนของมอมแมม →</a>
    </div>
  </section>

  <!-- LATEST ARTICLES -->
  {latest.length > 0 && (
    <section data-reveal style="background:#F2E9D8;padding:clamp(52px,7vw,96px) clamp(16px,4vw,48px);">
      <div style="max-width:1080px;margin:0 auto;">
        <h2 style="font-family:'Chonburi',serif;font-weight:400;font-size:clamp(24px,4vw,38px);line-height:1.25;margin:0 0 12px;color:#20302F;text-align:center;">บทความล่าสุดที่ผมเขียน</h2>
        <p style="text-align:center;font-size:16px;color:#6b6157;margin:0 auto 40px;max-width:44ch;">เขียนจากประสบการณ์ฝึกจริงและงานวิจัยด้านพฤติกรรมสุนัข</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;">
          {latest.map((p) => (
            <a href={`/blog/${p.id}`} style="display:block;background:#fff;border:1px solid rgba(140,120,80,.16);border-radius:18px;padding:24px 24px;text-decoration:none;box-shadow:0 10px 24px -22px rgba(42,37,33,.6);">
              <div style="font-size:13px;color:#178C88;font-weight:600;margin-bottom:8px;">{p.data.category}</div>
              <h3 style="font-family:'Sarabun',sans-serif;font-weight:700;font-size:17px;color:#20302F;margin:0 0 8px;line-height:1.45;">{p.data.title}</h3>
              <p style="font-size:13px;color:#8a8074;margin:0;">{fmt(p.data.pubDate)}</p>
            </a>
          ))}
        </div>
        <div style="margin-top:32px;text-align:center;">
          <a href="/blog" style="display:inline-block;color:#178C88;font-weight:600;font-size:16px;text-decoration:none;">อ่านบทความทั้งหมด →</a>
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section data-reveal style="background:linear-gradient(180deg,#0E6360 0%,#178C88 100%);color:#FBF8F1;padding:clamp(60px,8vw,110px) clamp(16px,4vw,48px);text-align:center;">
    <div style="max-width:680px;margin:0 auto;">
      <h2 style="font-family:'Chonburi',serif;font-weight:400;font-size:clamp(24px,4.5vw,42px);line-height:1.25;margin:0 0 16px;color:#FBF8F1;text-wrap:balance;">อยากปรึกษาเรื่องน้องกับผมโดยตรง?</h2>
      <p style="font-size:16px;line-height:1.75;color:rgba(251,248,241,.9);margin:0 auto 28px;max-width:44ch;">ทักมาเล่าเรื่องน้องได้เลย ปรึกษาฟรีทาง LINE แล้วเราค่อยวางแผนฝึกถึงบ้านให้เหมาะกับน้อง</p>
      <a href={site.lineUrl} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:10px;background:#F4C13C;color:#20302F;font-weight:700;font-size:18px;padding:16px 32px;border-radius:999px;text-decoration:none;box-shadow:0 6px 0 #DFA714;transition:transform .15s,box-shadow .15s;" onmouseover="this.style.transform='translateY(2px)';this.style.boxShadow='0 4px 0 #DFA714'" onmouseout="this.style.transform='';this.style.boxShadow='0 6px 0 #DFA714'"><span style="font-size:20px;">💬</span> แอด LINE ปรึกษาฟรี</a>
    </div>
  </section>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(person)} />
</BaseLayout>
