---
// Hero media = recall clip (mp4). Autoplay is started via JS only when the
// visitor hasn't asked for reduced motion (CLAUDE.md §4); otherwise the
// poster stays as a still image. muted+loop+playsinline for mobile autoplay.
//
// Layout: a 3-part grid so the H1 stays FIRST in the DOM (good for SEO +
// screen readers) while the visual order differs by screen:
//   mobile  → H1 → clip → tagline/zone/CTA  (promise → proof → action)
//   desktop → text column (H1 + body) left, clip right (unchanged look)
import { site } from '../config/site';
const heroVideo = '/uploads/dogsanook-recall-dog-training-bangkok.mp4';
const heroPoster = '/uploads/PXL_20251214_144515964.jpg';
---
<!-- H1 (single) — leads with game-based, not recall (CLAUDE.md §3/§9) -->
<header id="top" class="hero">
  <div class="hero-grid">
    <div class="hero-head">
      <div class="hero-badge">Game-Based Dog Training</div>
      <h1 class="hero-h1">ฝึกสุนัข<br /><span style="color:#F4C13C;">ด้วยการเล่นเกม</span></h1>
    </div>

    <div class="hero-media">
      <div class="hero-media-box">
        <video
          id="heroVideo"
          poster={heroPoster}
          muted
          loop
          playsinline
          preload="metadata"
          aria-label="คลิป recall — มอมแมม (เชลตี้) วิ่งเข้าหา สไตล์เล่นไปฝึกไป ไม่ดุ ไม่บังคับ"
        >
          <source src={heroVideo} type="video/mp4" />
        </video>
      </div>
    </div>

    <div class="hero-body">
      <p class="hero-sub">ครูฝึกสุนัขถึงบ้าน กรุงเทพฯ<br />เล่นไปฝึกไป · ไม่ดุ ไม่บังคับ</p>
      <p class="hero-zone">📍 บริการถึงบ้าน — กรุงเทพกรีฑา · รามคำแหง · พระราม 9 · ลาดกระบัง · บางพลี · สุวรรณภูมิ</p>
      <div class="hero-cta">
        <a href={site.lineUrl} target="_blank" rel="noopener" class="btn-gold" style="font-size:17px;padding:15px 28px;" onmouseover="this.style.transform='translateY(2px)';this.style.boxShadow='0 4px 0 #DFA714'" onmouseout="this.style.transform='';this.style.boxShadow='0 6px 0 #DFA714'"><span style="font-size:18px;">💬</span> แอด LINE ปรึกษาฟรี</a>
        <a href="#services" class="hero-cta-ghost" onmouseover="this.style.borderColor='#F4C13C'" onmouseout="this.style.borderColor='rgba(251,248,241,.55)'">ดูบริการ</a>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    background: linear-gradient(180deg, #2a2521 0%, #201c19 100%);
    color: #fbf8f1;
    padding: clamp(40px, 7vw, 80px) clamp(16px, 4vw, 48px) clamp(52px, 8vw, 96px);
  }
  .hero-grid {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 5vw, 26px);
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(244, 193, 60, 0.16);
    border: 1px solid rgba(244, 193, 60, 0.4);
    color: #f4c13c;
    font-weight: 600;
    font-size: 14px;
    padding: 7px 14px;
    border-radius: 999px;
    margin-bottom: 20px;
    letter-spacing: 0.02em;
  }
  .hero-h1 {
    font-family: 'Chonburi', serif;
    font-weight: 400;
    font-size: clamp(34px, 6vw, 60px);
    line-height: 1.18;
    margin: 0;
    color: #fbf8f1;
    text-wrap: balance;
  }
  .hero-media-box {
    position: relative;
    aspect-ratio: 4 / 5;
    width: 100%;
    /* cap the height on mobile so the CTA below stays reachable */
    max-width: min(100%, 44vh);
    margin-inline: auto;
    border-radius: 26px;
    overflow: hidden;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.5);
    border: 3px solid rgba(244, 193, 60, 0.35);
  }
  .hero-media-box video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero-sub {
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.7;
    color: rgba(251, 248, 241, 0.9);
    margin: 0 0 14px;
    max-width: 36ch;
  }
  .hero-zone {
    font-size: 15px;
    color: rgba(251, 248, 241, 0.75);
    margin: 0 0 28px;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }
  .hero-cta-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: #fbf8f1;
    font-weight: 600;
    font-size: 16px;
    padding: 14px 24px;
    border-radius: 999px;
    text-decoration: none;
    border: 2px solid rgba(251, 248, 241, 0.55);
    transition: border-color 0.15s;
  }

  /* Desktop: text column (H1 + body) left, clip right — clip spans both rows */
  @media (min-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(28px, 5vw, 56px);
      row-gap: 16px;
      align-items: center;
    }
    .hero-head { grid-column: 1; grid-row: 1; align-self: end; }
    .hero-body { grid-column: 1; grid-row: 2; align-self: start; }
    .hero-media { grid-column: 2; grid-row: 1 / span 2; align-self: center; }
    .hero-media-box { max-width: none; } /* fill the column on desktop */
  }
</style>

<script>
  // Start the hero clip only when motion is welcome; reduced-motion visitors
  // keep the still poster. Guards against browsers that block autoplay.
  const v = document.getElementById('heroVideo') as HTMLVideoElement | null;
  const reduce =
    window.matchMedia &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (v && !reduce) {
    v.play().catch(() => {
      /* autoplay blocked — poster stays, no error */
    });
  }
</script>
