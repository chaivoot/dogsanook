---
import { site } from '../config/site';
// Responsive nav: inline links on desktop, a CSS-only hamburger on mobile
// (checkbox toggle — no JS, works even with scripting off). Fixes the wrap
// where the wordmark + links overflowed on narrow screens.
---
<nav class="nav">
  <a href="/#top" class="nav-brand">
    <img src="/uploads/mommam.png" alt="โลโก้ หมาสนุก — มอมแมม" width="48" height="48" />
    <span>{site.name}</span>
  </a>

  <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
  <label for="nav-toggle" class="nav-burger" aria-label="เปิด/ปิดเมนู">
    <span></span><span></span><span></span>
  </label>

  <div class="nav-links">
    <a href="/course">คอร์ส</a>
    <a href="/blog">บทความ</a>
    <a href="/dog-trainer">ครูฝึก</a>
    <a href={site.lineUrl} target="_blank" rel="noopener" class="btn-gold nav-line">
      <span aria-hidden="true">💬</span> แอด LINE
    </a>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px clamp(16px, 4vw, 48px);
    background: rgba(251, 248, 241, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(140, 120, 80, 0.14);
  }
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-brand img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: block;
  }
  .nav-brand span {
    font-family: 'Chonburi', serif;
    font-size: 22px;
    color: #2a2521;
    line-height: 1;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(14px, 3vw, 26px);
  }
  .nav-links a:not(.btn-gold) {
    color: #2a2521;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-line {
    font-size: 15px;
    padding: 11px 20px;
    box-shadow: 0 4px 0 var(--gold-deep);
    white-space: nowrap;
  }
  .nav-burger { display: none; }

  /* Mobile: collapse links behind a hamburger toggle */
  @media (max-width: 720px) {
    .nav { flex-wrap: wrap; }
    .nav-burger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      padding: 11px 8px;
      cursor: pointer;
      border-radius: 10px;
    }
    .nav-burger span {
      display: block;
      height: 2.5px;
      background: #2a2521;
      border-radius: 2px;
      transition: transform 0.25s ease, opacity 0.2s ease;
    }
    .nav-links {
      display: none;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      gap: 4px;
      padding-top: 8px;
    }
    .nav-toggle:checked ~ .nav-links { display: flex; }
    .nav-links a:not(.btn-gold) {
      padding: 13px 8px;
      border-radius: 10px;
      font-size: 16px;
    }
    .nav-line {
      align-self: flex-start;
      margin-top: 4px;
    }
    /* burger → X when open */
    .nav-toggle:checked ~ .nav-burger span:nth-child(1) {
      transform: translateY(7.5px) rotate(45deg);
    }
    .nav-toggle:checked ~ .nav-burger span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .nav-burger span:nth-child(3) {
      transform: translateY(-7.5px) rotate(-45deg);
    }
  }
</style>
