---
// Mobile-only sticky LINE CTA pinned to the bottom of the viewport. Most
// visitors (esp. Google Ads) are on mobile, so a persistent one-tap "add LINE"
// lowers friction on every page. Hidden on desktop (the sticky Nav already
// carries a LINE button there). Click is auto-tracked by the add_line listener
// in BaseLayout. Respects the iOS home-bar safe area.
import { site } from '../config/site';
---
<a href={site.lineUrl} target="_blank" rel="noopener" class="sticky-line" aria-label="แอด LINE ปรึกษาฟรี"><span aria-hidden="true">💬</span> แอด LINE ปรึกษาฟรี</a>
<style>
  .sticky-line { display: none; }
  @media (max-width: 768px) {
    .sticky-line {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 900;
      background: #F4C13C;
      color: #20302F;
      font-family: 'Prompt', sans-serif;
      font-weight: 700;
      font-size: 16px;
      text-decoration: none;
      padding: 14px 16px calc(14px + env(safe-area-inset-bottom));
      box-shadow: 0 -4px 16px rgba(42, 37, 33, 0.18);
    }
    body { padding-bottom: 70px; }
  }
</style>
