---
// Cross-zone block for zone landing pages. Lists the OTHER focus zones that
// have a page (from site.zonePages) so a visitor who landed on the "wrong"
// zone — but is still inside a zone we cover — finds their page instead of
// bouncing. A soft LINE catch-all line follows for anyone whose area isn't
// listed (we serve Bangkok-wide + nearby on request, but don't advertise that
// here — see CLAUDE.md §7). Config-driven: add a slug to site.zonePages and it
// appears on every zone page automatically.
import { site } from '../config/site';

interface Props {
  current: string; // the current page's path, e.g. "/dog-training-ramkhamhaeng"
}
const { current } = Astro.props;

const others = site.zones
  .map((z) => ({ name: z, href: site.zonePages[z] ?? null }))
  .filter((z): z is { name: string; href: string } => !!z.href && z.href !== current);
---
<section style="background:#E3F1EF;padding:clamp(44px,6vw,80px) clamp(16px,4vw,48px);">
  <div style="max-width:820px;margin:0 auto;">
    <h2 style="font-family:'Prompt',sans-serif;font-weight:700;font-size:clamp(22px,3.6vw,32px);line-height:1.3;margin:0 0 8px;color:#0E6360;">ให้บริการย่านอื่นด้วย</h2>
    <p style="font-size:16px;color:#2f6361;line-height:1.75;margin:0 0 20px;max-width:58ch;">ครูฝึกถึงบ้านในหลายย่านฝั่งตะวันออก–ตะวันออกเฉียงใต้ของกรุงเทพฯ เลือกดูหน้าย่านของคุณได้เลย</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px;">
      {others.map((z) => (
        <a href={z.href} style="display:block;background:#fff;border:1px solid rgba(23,140,136,.22);border-radius:14px;padding:15px 18px;font-size:15.5px;font-weight:700;color:#0E6360;text-decoration:none;">ฝึกสุนัขถึงบ้าน {z.name} →</a>
      ))}
    </div>
    <p style="font-size:15.5px;color:#2f6361;line-height:1.75;margin:22px 0 0;">ย่านของคุณไม่อยู่ในลิสต์? <a href={site.lineUrl} target="_blank" rel="noopener" style="color:#0E6360;font-weight:700;text-decoration:underline;">ทัก LINE มาถามได้เลย</a> 💬 เช็กให้ว่าไปถึงไหม</p>
  </div>
</section>
