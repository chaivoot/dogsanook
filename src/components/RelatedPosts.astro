---
// Related-posts block shown at the foot of every blog article.
// Selection: same category first (newest first), then fill with the most
// recent other posts — always up to 3, never the current post. This adds
// internal links into each article so Google has more paths to crawl them
// (helps "Discovered – currently not indexed"), and keeps readers on-site.
import ImageSlot from './ImageSlot.astro';
import { getLivePosts, type BlogPost } from '../lib/posts';

const { post } = Astro.props as { post: BlogPost };

const all = await getLivePosts();
const others = all.filter((p) => p.id !== post.id);
const sameCat = others.filter((p) => p.data.category === post.data.category);
const rest = others.filter((p) => p.data.category !== post.data.category);
const related = [...sameCat, ...rest].slice(0, 3);
---
{related.length > 0 && (
  <section style="margin-top:48px;">
    <h2 style="font-family:'Prompt',sans-serif;font-weight:700;font-size:22px;color:#2A2521;margin:0 0 18px;">บทความที่เกี่ยวข้อง</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px;">
      {related.map((p) => (
        <a
          href={`/blog/${p.id}`}
          style="text-decoration:none;color:inherit;display:flex;flex-direction:column;background:#fff;border:1px solid rgba(140,120,80,.16);border-radius:16px;overflow:hidden;box-shadow:0 8px 20px -16px rgba(42,37,33,.6);transition:transform .18s,box-shadow .18s;"
          onmouseover="this.style.transform='translateY(-4px)';this.style.boxShadow='0 16px 30px -18px rgba(42,37,33,.5)'"
          onmouseout="this.style.transform='';this.style.boxShadow='0 8px 20px -16px rgba(42,37,33,.6)'"
        >
          <div style="aspect-ratio:16/10;">
            <ImageSlot src={p.data.heroImage} alt={p.data.heroAlt ?? p.data.title} placeholder="ภาพประกอบบทความ" />
          </div>
          <div style="padding:14px 16px;">
            <div style="font-size:11.5px;font-weight:700;color:#DFA714;letter-spacing:.05em;margin-bottom:6px;">{p.data.category}</div>
            <h3 style="font-family:'Prompt',sans-serif;font-weight:700;font-size:15.5px;color:#2A2521;margin:0;line-height:1.45;">{p.data.title}</h3>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
