---
// Prices shown on-site only (never in Google Business description — §9).
import { site } from '../config/site';
---
<section id="pricing" data-reveal style="background:#2A2521;color:#FBF8F1;padding:clamp(40px,6vw,76px) clamp(16px,4vw,48px);">
  <div style="max-width:960px;margin:0 auto;">
    <h2 style="font-family:'Prompt',sans-serif;font-weight:700;font-size:clamp(28px,5vw,50px);line-height:1.2;margin:0 0 12px;color:#FBF8F1;text-align:center;">แพ็กเกจ &amp; ราคาฝึกสุนัข</h2>
    <p style="text-align:center;font-size:clamp(17px,2.4vw,20px);color:#FBF8F1;font-weight:600;margin:0 0 44px;">ฝึกถึงบ้าน · <span style="color:#F4C13C;">ประเมินและวางแผนเฉพาะน้องแต่ละตัว</span></p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:22px;align-items:stretch;">
      <div style="position:relative;background:#FBF8F1;color:#20302F;border-radius:22px;padding:30px 28px;display:flex;flex-direction:column;box-shadow:0 24px 48px -20px rgba(0,0,0,.5);">
        <div style="font-weight:700;font-size:14px;color:#8A6A18;letter-spacing:.05em;margin-bottom:6px;">Puppy Training</div>
        <h3 style="font-family:'Prompt',sans-serif;font-weight:700;font-size:22px;color:#2A2521;margin:0 0 4px;">คลาสลูกสุนัข</h3>
        <p style="font-size:13.5px;color:#7c7266;margin:0 0 6px;">ปูพื้นฐานช่วงลูกหมา — ขับถ่ายเป็นที่ ใส่ฮาร์เนส เข้าสังคม และเกมพื้นฐาน</p>
        <a href="/puppy-training" style="font-size:13.5px;color:#8A6A18;font-weight:600;text-decoration:none;margin:0 0 18px;display:inline-block;">ดูรายละเอียดคลาสลูกสุนัข →</a>
        <div style="display:flex;align-items:baseline;gap:10px;margin-bottom:6px;"><span style="font-family:'Prompt',sans-serif;font-weight:700;font-size:30px;color:#2A2521;">สอบถามราคา</span></div>
        <div style="font-size:15px;color:#6b6157;margin-bottom:22px;">ประเมินน้องและวางแผนก่อนเริ่ม คุยรายละเอียดกันทาง LINE</div>
        <a href={site.lineUrl} target="_blank" rel="noopener" class="btn-gold" style="margin-top:auto;justify-content:center;font-size:16px;padding:14px;box-shadow:0 5px 0 #DFA714;" onmouseover="this.style.transform='translateY(2px)';this.style.boxShadow='0 3px 0 #DFA714'" onmouseout="this.style.transform='';this.style.boxShadow='0 5px 0 #DFA714'">แอด LINE ปรึกษาคลาสลูกสุนัข</a>
      </div>
      <div style="background:rgba(251,248,241,.06);border:1px solid rgba(244,193,60,.28);border-radius:22px;padding:30px 28px;display:flex;flex-direction:column;">
        <div style="font-weight:700;font-size:14px;color:#F4C13C;letter-spacing:.05em;margin-bottom:6px;">Core Training</div>
        <h3 style="font-family:'Prompt',sans-serif;font-weight:700;font-size:22px;color:#FBF8F1;margin:0 0 4px;">คอร์สหลัก เล่นไปฝึกไป</h3>
        <p style="font-size:13.5px;color:rgba(251,248,241,.7);margin:0 0 6px;">ฝึกพื้นฐาน มารยาท เรียกกลับมา (recall) และเกม สำหรับน้องทั่วไป</p>
        <a href="/course" style="font-size:13.5px;color:#F4C13C;font-weight:600;text-decoration:none;margin:0 0 18px;display:inline-block;">ดู 10 เกมในคอร์ส →</a>
        <div style="display:flex;align-items:baseline;gap:10px;margin-bottom:6px;"><span style="font-family:'Prompt',sans-serif;font-weight:700;font-size:30px;color:#F4C13C;">สอบถามราคา</span></div>
        <div style="font-size:15px;color:rgba(251,248,241,.75);margin-bottom:22px;">วางแผนเป็นรายเคส คุยรายละเอียดกันทาง LINE</div>
        <a href={site.lineUrl} target="_blank" rel="noopener" style="margin-top:auto;display:block;text-align:center;background:transparent;color:#FBF8F1;font-weight:700;font-size:16px;padding:13px;border-radius:999px;text-decoration:none;border:2px solid rgba(251,248,241,.55);transition:border-color .15s;" onmouseover="this.style.borderColor='#F4C13C'" onmouseout="this.style.borderColor='rgba(251,248,241,.55)'">ปรึกษาเรื่องคอร์ส</a>
      </div>
    </div>
    <p style="text-align:center;font-size:13.5px;color:rgba(251,248,241,.65);margin:26px 0 0;">ราคาขึ้นกับบริการและโซนที่ให้บริการ · สอบถามและปรึกษาได้ทาง LINE</p>
  </div>
</section>
