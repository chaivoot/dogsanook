---
/*
 * StudentShowcase — a single looping montage of real in-home training clips
 * ("นักเรียน" = dogs we've trained), placed right under the hero as social proof.
 * The montage is a 3x3 grid exported as one muted video; it lazy-loads and
 * autoplays only when scrolled into view (set via data-src by the script), so
 * the hero's LCP stays clean. Respects prefers-reduced-motion. Teal-forward to
 * echo the logo (CLAUDE.md §4).
 *
 * SEO: the H2 carries a real search term, and a VideoObject JSON-LD exposes the
 * clip to Google (contentUrl + thumbnail) since the <video> src is JS-injected.
 *
 * Swap the montage by uploading <name>.mp4 (H.264) + <name>.jpg (poster) to
 * /public/uploads and updating the paths below. Set montage = null to hide.
 */
import { site } from '../config/site';

const montage: {
  src: string;
  poster: string;
  name: string;
  description: string;
  uploadDate: string;
  duration: string;
} | null = {
  src: '/uploads/dog-training-students.mp4',
  poster: '/uploads/dog-training-students.jpg',
  name: 'น้อง ๆ นักเรียนหมาสนุก — ฝึกสุนัขถึงบ้าน หลากหลายพันธุ์',
  description:
    'คลิปรวมน้องหลายพันธุ์ที่หมาสนุกไปฝึกถึงบ้าน กรุงเทพฯ สไตล์เล่นไปฝึกไป ไม่ดุ ไม่บังคับ — นั่ง คอย เรียกกลับมา ปูพื้นฐานลูกหมา และมารยาทในบ้าน',
  uploadDate: '2026-11-09T09:00:00+07:00',
  duration: 'PT30S',
};

const videoSchema = montage && {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  '@id': `${site.domain}/#students-video`,
  name: montage.name,
  description: montage.description,
  thumbnailUrl: [new URL(montage.poster, site.domain).href],
  contentUrl: new URL(montage.src, site.domain).href,
  uploadDate: montage.uploadDate,
  duration: montage.duration,
  publisher: { '@id': `${site.domain}/#business` },
  isPartOf: { '@id': `${site.domain}/#website` },
};
---

{montage && (
  <section data-reveal aria-labelledby="students-h2" style="background:#E3F1EF;padding:clamp(52px,8vw,100px) clamp(16px,4vw,48px);">
    <div style="max-width:900px;margin:0 auto;">
      <h2 id="students-h2" style="font-family:'Prompt',sans-serif;font-weight:700;font-size:clamp(27px,5vw,46px);line-height:1.2;margin:0 0 12px;color:#0E6360;text-align:center;">ผลงานฝึกสุนัขถึงบ้าน น้อง ๆ นักเรียนของเรา</h2>
      <p style="text-align:center;font-size:clamp(16px,2.4vw,19px);color:#20302F;max-width:660px;margin:0 auto 36px;">ตัวอย่างน้องที่เราไปฝึกถึงบ้าน หลากหลายพันธุ์ หลากหลายทักษะ สไตล์เล่นไปฝึกไป ไม่ดุ ไม่บังคับ</p>

      <div class="student-media">
        <video
          id="studentMontage"
          class="student-video"
          muted
          loop
          playsinline
          preload="none"
          poster={montage.poster}
          data-src={montage.src}
          aria-label={montage.description}
        ></video>
      </div>

      <div style="text-align:center;margin-top:36px;">
        <a href={site.lineUrl} target="_blank" rel="noopener" class="btn-gold" style="font-size:16px;padding:14px 28px;box-shadow:0 5px 0 var(--gold-deep);" onmouseover="this.style.transform='translateY(2px)';this.style.boxShadow='0 3px 0 #DFA714'" onmouseout="this.style.transform='';this.style.boxShadow='0 5px 0 #DFA714'">อยากให้น้องเป็นนักเรียนคนต่อไป? แอด LINE</a>
      </div>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
  </section>
)}

<style>
  .student-media {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 20px;
    overflow: hidden;
    background: #0E6360;
    box-shadow: 0 22px 46px -24px rgba(14, 99, 96, 0.6);
  }
  .student-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>

<script>
  // Lazy-load + autoplay the montage only while in view (bandwidth + LCP).
  // Reduced-motion: show controls, never autoplay.
  const v = document.getElementById('studentMontage') as HTMLVideoElement | null;
  if (v) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) v.setAttribute('controls', '');
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            if (!v.src && v.dataset.src) v.src = v.dataset.src;
            if (!reduce) v.play().catch(() => {});
          } else if (!v.paused) {
            v.pause();
          }
        });
      },
      { threshold: 0.3 }
    );
    io.observe(v);
  }
</script>
