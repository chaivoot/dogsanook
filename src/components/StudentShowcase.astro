---
/*
 * StudentShowcase — real in-home training clips ("นักเรียน" = dogs we've trained).
 * Social proof placed right under the hero. Each clip is muted + loops and
 * plays ONLY when scrolled into view (set via data-src by the script below), so
 * the page does not download every video up front (Core Web Vitals).
 * Respects prefers-reduced-motion. Teal-forward to echo the logo (CLAUDE.md §4).
 *
 * To add a clip: upload <name>.mp4 + <name>.jpg (poster) to /public/uploads,
 * then add an entry here. An empty list hides the whole section.
 */
import { site } from '../config/site';

type Clip = {
  src: string; // /uploads/<name>.mp4
  poster: string; // /uploads/<name>.jpg (first frame)
  ratio?: string; // CSS aspect-ratio, default 16/9
  caption: string; // breed + skill, e.g. "น้องชิบะ ฝึกนั่งคอย"
};

const clips: Clip[] = [
  // Populated once the owner uploads the mp4 clips. Example:
  // { src: '/uploads/student-bichon.mp4', poster: '/uploads/student-bichon.jpg', caption: 'น้องบิชอง ฝึกความมั่นใจและการทรงตัว' },
];
---

{clips.length > 0 && (
  <section data-reveal aria-labelledby="students-h2" style="background:#E3F1EF;padding:clamp(52px,8vw,100px) clamp(16px,4vw,48px);">
    <div style="max-width:1080px;margin:0 auto;">
      <h2 id="students-h2" style="font-family:'Chonburi',serif;font-weight:400;font-size:clamp(28px,5vw,48px);line-height:1.2;margin:0 0 12px;color:#0E6360;text-align:center;">น้อง ๆ นักเรียนของเรา</h2>
      <p style="text-align:center;font-size:clamp(16px,2.4vw,19px);color:#20302F;max-width:640px;margin:0 auto 40px;">คลิปฝึกจริงถึงบ้าน หลากหลายพันธุ์ หลากหลายทักษะ สไตล์เล่นไปฝึกไป ไม่ดุ ไม่บังคับ</p>

      <div class="student-grid">
        {clips.map((c) => (
          <figure class="student-card">
            <div class="student-media" style={`aspect-ratio:${c.ratio ?? '16/9'};`}>
              <video
                class="student-video"
                muted
                loop
                playsinline
                preload="none"
                poster={c.poster}
                data-src={c.src}
                aria-label={c.caption}
              ></video>
            </div>
            <figcaption class="student-cap">{c.caption}</figcaption>
          </figure>
        ))}
      </div>

      <div style="text-align:center;margin-top:40px;">
        <a href={site.lineUrl} target="_blank" rel="noopener" class="btn-gold" style="font-size:16px;padding:14px 28px;box-shadow:0 5px 0 var(--gold-deep);" onmouseover="this.style.transform='translateY(2px)';this.style.boxShadow='0 3px 0 #DFA714'" onmouseout="this.style.transform='';this.style.boxShadow='0 5px 0 #DFA714'">อยากให้น้องเป็นนักเรียนคนต่อไป? แอด LINE</a>
      </div>
    </div>
  </section>
)}

<style>
  .student-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 22px;
  }
  .student-card {
    margin: 0;
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 18px 38px -22px rgba(14, 99, 96, 0.5);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .student-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 46px -22px rgba(14, 99, 96, 0.6);
  }
  .student-media {
    width: 100%;
    background: #0E6360;
  }
  .student-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .student-cap {
    padding: 14px 18px;
    font-size: 15px;
    font-weight: 600;
    color: #20302F;
  }
  @media (prefers-reduced-motion: reduce) {
    .student-card:hover {
      transform: none;
    }
  }
</style>

<script>
  // Lazy-load + autoplay clips only while in view. Saves bandwidth and keeps
  // the hero's LCP clean. Reduced-motion: show controls, never autoplay.
  const vids = document.querySelectorAll<HTMLVideoElement>('.student-video');
  if (vids.length) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            if (!v.src && v.dataset.src) v.src = v.dataset.src;
            if (!reduce) v.play().catch(() => {});
          } else if (!v.paused) {
            v.pause();
          }
        });
      },
      { threshold: 0.4 }
    );
    vids.forEach((v) => {
      if (reduce) v.setAttribute('controls', '');
      io.observe(v);
    });
  }
</script>
